--- baseline/src/io/param_menu_controller.v
+++ p01_menu/src/io/param_menu_controller.v
@@ -45,6 +45,13 @@
     localparam integer LONG_CYCLES     = (CLK_FREQ_HZ / 1000) * LONG_HOLD_MS;
     localparam integer TIMEOUT_CYCLES  = (CLK_FREQ_HZ / 1000) * MENU_TIMEOUT_MS;
 
+    // Include the saturated threshold itself (also for power-of-two limits).
+    // Keep the original 32-bit behavior for non-positive parameter products.
+    localparam integer DEB_CNT_W = (DEBOUNCE_CYCLES > 0) ? $clog2(DEBOUNCE_CYCLES + 64'd1) : 32;
+    localparam integer COMBO_CNT_W = (COMBO_CYCLES > 0) ? $clog2(COMBO_CYCLES + 64'd1) : 32;
+    localparam integer HOLD_CNT_W = (LONG_CYCLES > 0) ? $clog2(LONG_CYCLES + 64'd1) : 32;
+    localparam integer IDLE_CNT_W = (TIMEOUT_CYCLES > 0) ? $clog2(TIMEOUT_CYCLES + 64'd1) : 32;
+
     localparam integer BRIGHT_STEPS = 5;
     localparam integer CONTRAST_STEPS = 5;
 
@@ -108,20 +115,19 @@
     reg       key2_raw;
     reg       key1_stable;
     reg       key2_stable;
-    // 100MHz、20ms 消抖需要 2_000_000 个周期，20 位计数器最大只能到
-    // 1_048_575，会导致 stable 状态永远无法更新。这里必须使用 32 位。
-    reg [31:0] key1_deb_cnt;
-    reg [31:0] key2_deb_cnt;
+    // 100MHz、20ms 需要 21 位；按参数派生，避免原 20 位回卷问题。
+    reg [DEB_CNT_W-1:0] key1_deb_cnt;
+    reg [DEB_CNT_W-1:0] key2_deb_cnt;
 
     // 组合键判定与菜单内按住计时
-    reg [31:0] combo_cnt;
+    reg [COMBO_CNT_W-1:0] combo_cnt;
     reg        combo_long;
-    reg [31:0] key1_hold_cnt;
-    reg [31:0] key2_hold_cnt;
+    reg [HOLD_CNT_W-1:0] key1_hold_cnt;
+    reg [HOLD_CNT_W-1:0] key2_hold_cnt;
     reg        key1_long;
     reg        key2_long;
     reg        menu_entry_lock;
-    reg [31:0] menu_idle_cnt;
+    reg [IDLE_CNT_W-1:0] menu_idle_cnt;
     reg [3:0]  lvl_next;
 
     wire combo_pressed = (key1_sync[1] == 1'b0) && (key2_sync[1] == 1'b0);
