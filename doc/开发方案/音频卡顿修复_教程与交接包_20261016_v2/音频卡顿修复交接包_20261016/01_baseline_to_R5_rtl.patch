diff --git a/src/audio/audio_prefetch_stage.v b/src/audio/audio_prefetch_stage.v
new file mode 100644
--- /dev/null
+++ b/src/audio/audio_prefetch_stage.v
@@ -0,0 +1,51 @@
+`ifndef VINYL_AUDIO_PREFETCH_STAGE_V
+`define VINYL_AUDIO_PREFETCH_STAGE_V
+`timescale 1ns/1ps
+// One BRAM32K, shared by held-data mailboxes. No bulk RAM reset is needed:
+// a complete sector is published only after its writer acknowledges completion.
+module audio_prefetch_stage (
+    input a_clk, a_en, a_we,
+    input [9:0] a_addr,
+    input [7:0] a_din,
+    output [7:0] a_dout,
+    input b_clk, b_en, b_we,
+    input [9:0] b_addr,
+    input [7:0] b_din,
+    output [7:0] b_dout
+);
+`ifdef VINYL_AUDIO_CACHE_SIM
+    reg [15:0] memory [0:2047];
+    reg [7:0] qa=0, qb=0;
+    assign a_dout=qa;
+    assign b_dout=qb;
+    always @(posedge a_clk) begin
+        if (a_en) begin
+            if (a_we) memory[{1'b0,a_addr}] <= {8'd0,a_din};
+            else qa <= memory[{1'b0,a_addr}][7:0];
+        end
+    end
+    always @(posedge b_clk) begin
+        if (b_en) begin
+            if (b_we) memory[{1'b0,b_addr}] <= {8'd0,b_din};
+            else qb <= memory[{1'b0,b_addr}][7:0];
+        end
+    end
+`else
+    wire [15:0] qa,qb;
+    assign a_dout=qa[7:0];
+    assign b_dout=qb[7:0];
+    EG_PHY_BRAM32K #(
+        .MODE("DP16K"),.DATA_WIDTH_A("16"),.DATA_WIDTH_B("16"),
+        .REGMODE_A("NOREG"),.REGMODE_B("NOREG"),
+        .WRITEMODE_A("NORMAL"),.WRITEMODE_B("NORMAL"),.SRMODE("SYNC")
+    ) storage (
+        .clka(a_clk),.csa(a_en),.wea(a_we),.addra({1'b0,a_addr}),
+        .dia({8'd0,a_din}),.doa(qa),.bytea(1'b0),.bytewea(1'b0),
+        .rsta(1'b0),.ocea(1'b1),
+        .clkb(b_clk),.csb(b_en),.web(b_we),.addrb({1'b0,b_addr}),
+        .dib({8'd0,b_din}),.dob(qb),.byteb(1'b0),.byteweb(1'b0),
+        .rstb(1'b0),.oceb(1'b1)
+    );
+`endif
+endmodule
+`endif
diff --git a/src/audio/audio_sdram_dma.v b/src/audio/audio_sdram_dma.v
new file mode 100644
--- /dev/null
+++ b/src/audio/audio_sdram_dma.v
@@ -0,0 +1,187 @@
+`ifndef VINYL_AUDIO_SDRAM_DMA_V
+`define VINYL_AUDIO_SDRAM_DMA_V
+`timescale 1ns/1ps
+// The request payload is a bundled-data mailbox: keep sector and toggle stable
+// until the matching acknowledgement returns. No command backpressure exists on
+// this SDRAM user port: acquire ownership before issuing a contiguous chunk.
+module audio_sdram_dma #(
+    parameter integer BURST_WORDS = 32,
+    parameter integer DRAIN_CYCLES = 16,
+    parameter integer YIELD_CYCLES = 16,
+    parameter integer WATCHDOG_BITS = 18
+)(
+    input mem_clk, rst_n,
+    input write_request_toggle,
+    input [9:0] write_sector,
+    output reg write_ack_toggle = 1'b0,
+    output reg [7:0] write_error = 8'd0,
+    input read_request_toggle,
+    input [9:0] read_sector,
+    output reg read_ack_toggle = 1'b0,
+    output reg [7:0] read_error = 8'd0,
+    output stage_en, stage_we,
+    output [9:0] stage_addr,
+    output [7:0] stage_din,
+    input [7:0] stage_dout,
+    input video_read_busy, video_write_busy, controller_busy, refresh_active,
+    input mem_read_valid,
+    input [31:0] mem_read_data,
+    output access_lock, read_owner,
+    output mem_wr_en,
+    output [20:0] mem_wr_addr,
+    output [31:0] mem_wr_data,
+    output [3:0] mem_wr_mask,
+    output mem_rd_en,
+    output [20:0] mem_rd_addr
+);
+    localparam [3:0] S_IDLE=0, S_LOCK=1, S_WRITE=2, S_READ=3,
+                     S_WRITE_DRAIN=4, S_READ_DRAIN=5, S_YIELD=6,
+                     S_DONE=7, S_FAIL=8;
+    localparam integer COUNT_BITS = (BURST_WORDS < 2) ? 1 : $clog2(BURST_WORDS+1);
+    localparam integer QUIET_BITS = (DRAIN_CYCLES < 2) ? 1 : $clog2(DRAIN_CYCLES+1);
+    localparam integer YIELD_BITS = (YIELD_CYCLES < 2) ? 1 : $clog2(YIELD_CYCLES+1);
+    reg write_sync0=0, write_sync1=0, read_sync0=0, read_sync1=0;
+    reg [3:0] state = S_IDLE;
+    reg operation_read=0, operation_token=0;
+    reg [9:0] sector=0;
+    reg [8:0] chunk_base=0;
+    reg [COUNT_BITS-1:0] sent_count=0, received_count=0;
+    reg [QUIET_BITS-1:0] quiet_count=0;
+    reg [YIELD_BITS-1:0] yield_count=0;
+    reg [WATCHDOG_BITS-1:0] watchdog=0;
+    reg write_valid=0;
+    reg [20:0] write_address=0;
+    wire take_read = state == S_IDLE && read_sync1 != read_ack_toggle;
+    wire take_write = state == S_IDLE && !take_read && write_sync1 != write_ack_toggle;
+    wire [9:0] remaining_words = 10'd512 - {1'b0,chunk_base};
+    wire [COUNT_BITS-1:0] chunk_limit = remaining_words < BURST_WORDS
+                                                   ? remaining_words : BURST_WORDS;
+    wire [9:0] next_base = {1'b0,chunk_base} + chunk_limit;
+    wire [8:0] sent_offset = chunk_base + sent_count;
+    wire [8:0] received_offset = chunk_base + received_count;
+    wire quiet = !video_read_busy && !video_write_busy && !controller_busy &&
+                 !refresh_active && !mem_read_valid && !mem_wr_en && !mem_rd_en;
+    wire drain_ready = quiet && (DRAIN_CYCLES == 0 || quiet_count >= DRAIN_CYCLES-1);
+    wire read_complete = received_count == chunk_limit;
+    wire chunk_done = (state == S_WRITE_DRAIN && drain_ready) ||
+                      (state == S_READ_DRAIN && read_complete && drain_ready);
+    wire active = state == S_LOCK || state == S_WRITE || state == S_READ ||
+                  state == S_WRITE_DRAIN || state == S_READ_DRAIN;
+    wire expired = &watchdog;
+    wire received_word = read_owner && mem_read_valid && !read_complete;
+
+    // Both outputs depend only on registered state, never on live busy inputs.
+    // In S_LOCK old video returns still belong to the video reader.
+    assign access_lock = active;
+    assign read_owner = state == S_READ || state == S_READ_DRAIN;
+    assign mem_rd_en = state == S_READ;
+    assign mem_rd_addr = {2'b00,sector,sent_offset};
+    assign mem_wr_en = write_valid;
+    assign mem_wr_addr = write_address;
+    assign mem_wr_data = {24'd0,stage_dout};
+    assign mem_wr_mask = 4'b1110;
+    assign stage_en = state == S_WRITE || received_word;
+    assign stage_we = received_word;
+    assign stage_addr = received_word ? {1'b1,received_offset} : {1'b0,sent_offset};
+    assign stage_din = mem_read_data[7:0];
+
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_sync0 <= 0; else write_sync0 <= write_request_toggle;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_sync1 <= 0; else write_sync1 <= write_sync0;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) read_sync0 <= 0; else read_sync0 <= read_request_toggle;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) read_sync1 <= 0; else read_sync1 <= read_sync0;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) operation_read <= 0;
+        else if (take_read || take_write) operation_read <= take_read;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) operation_token <= 0;
+        else if (take_read || take_write) operation_token <= take_read ? read_sync1 : write_sync1;
+    end
+    // Payload has already been stable for the two toggle synchronizer clocks.
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) sector <= 0;
+        else if (take_read || take_write) sector <= take_read ? read_sector : write_sector;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) state <= S_IDLE;
+        else if (active && expired) state <= S_FAIL;
+        else case (state)
+            S_IDLE: if (take_read || take_write) state <= S_LOCK;
+            S_LOCK: if (drain_ready) state <= operation_read ? S_READ : S_WRITE;
+            S_WRITE: if (sent_count == chunk_limit-1'b1) state <= S_WRITE_DRAIN;
+            S_READ: if (sent_count == chunk_limit-1'b1) state <= S_READ_DRAIN;
+            S_WRITE_DRAIN, S_READ_DRAIN:
+                if (chunk_done) state <= next_base == 10'd512 ? S_DONE : S_YIELD;
+            S_YIELD: if (YIELD_CYCLES == 0 || yield_count >= YIELD_CYCLES-1) state <= S_LOCK;
+            S_DONE, S_FAIL: state <= S_IDLE;
+            default: state <= S_IDLE;
+        endcase
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) chunk_base <= 0;
+        else if (take_read || take_write) chunk_base <= 0;
+        else if (chunk_done) chunk_base <= next_base[8:0];
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) sent_count <= 0;
+        else if (state == S_LOCK) sent_count <= 0;
+        else if (state == S_WRITE || state == S_READ) sent_count <= sent_count + 1'b1;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) received_count <= 0;
+        else if (state == S_LOCK) received_count <= 0;
+        else if (received_word) received_count <= received_count + 1'b1;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) quiet_count <= 0;
+        else if (!active || !quiet || (state == S_READ_DRAIN && !read_complete)) quiet_count <= 0;
+        else if (!drain_ready) quiet_count <= quiet_count + 1'b1;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) yield_count <= 0;
+        else if (state != S_YIELD) yield_count <= 0;
+        else if (yield_count < YIELD_CYCLES) yield_count <= yield_count + 1'b1;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) watchdog <= 0;
+        else if (!active || mem_wr_en || mem_rd_en || received_word || chunk_done) watchdog <= 0;
+        else if (!expired) watchdog <= watchdog + 1'b1;
+    end
+    // The synchronous staging RAM and this register advance on the same edge.
+    // Thus stage_dout and write_address refer to the same preceding RAM read.
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_valid <= 0;
+        else write_valid <= state == S_WRITE;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_address <= 0;
+        else if (state == S_WRITE) write_address <= {2'b00,sector,sent_offset};
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_ack_toggle <= 0;
+        else if ((state == S_DONE || state == S_FAIL) && !operation_read) write_ack_toggle <= operation_token;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) read_ack_toggle <= 0;
+        else if ((state == S_DONE || state == S_FAIL) && operation_read) read_ack_toggle <= operation_token;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) write_error <= 0;
+        else if (take_write) write_error <= 0;
+        else if (active && expired && !operation_read) write_error <= 8'h01;
+    end
+    always @(posedge mem_clk or negedge rst_n) begin
+        if (!rst_n) read_error <= 0;
+        else if (take_read) read_error <= 0;
+        else if (active && expired && operation_read) read_error <= 8'h02;
+    end
+endmodule
+`endif
diff --git a/src/audio/audio_prefetch_sdram.v b/src/audio/audio_prefetch_sdram.v
new file mode 100644
--- /dev/null
+++ b/src/audio/audio_prefetch_sdram.v
@@ -0,0 +1,250 @@
+`ifndef VINYL_AUDIO_PREFETCH_SDRAM_V
+`define VINYL_AUDIO_PREFETCH_SDRAM_V
+`timescale 1ns/1ps
+// SD-clock sector cache. A committed ring entry always contains all 512 bytes.
+// Session cancellation drains issued SD/DMA operations before reusing staging;
+// request toggles and their sector payloads are never reset by a seek/stop.
+module audio_prefetch_sdram #(
+    parameter integer PREFILL_SECTORS=960,
+    parameter integer HIGH_SECTORS=1008,
+    parameter integer LOW_SECTORS=960
+)(
+    input sd_clk, sd_rst_n, mem_clk, mem_rst_n,
+    input source_ready, enable,
+    input [31:0] start_lba, total_sectors,
+    input client_req,
+    output client_busy, client_valid,
+    output [7:0] client_byte,
+    output [8:0] client_byte_index,
+    output client_done,
+    output [7:0] client_error,
+    output raw_req,
+    output reg [31:0] raw_lba=0,
+    input raw_busy, raw_valid,
+    input [7:0] raw_byte,
+    input [8:0] raw_byte_index,
+    input raw_done,
+    input [7:0] raw_error,
+    output reg playback_ready=0,
+    output prefetch_low, session_busy,
+    input video_read_busy,video_write_busy,controller_busy,refresh_active,
+    input mem_read_valid,
+    input [31:0] mem_read_data,
+    output access_lock,read_owner,mem_wr_en,
+    output [20:0] mem_wr_addr,
+    output [31:0] mem_wr_data,
+    output [3:0] mem_wr_mask,
+    output mem_rd_en,
+    output [20:0] mem_rd_addr
+);
+    localparam [2:0] P_IDLE=0,P_REQUEST=1,P_FILL=2,P_COMMIT=3;
+    localparam [2:0] C_IDLE=0,C_LOAD=1,C_SEND=2,C_DONE=3,C_ERROR=4;
+    reg [2:0] producer_state=P_IDLE,consumer_state=C_IDLE;
+    reg session_active=0,prefill_ready=0,refilling=0;
+    reg [31:0] producer_remaining=0,consumer_remaining=0;
+    reg [10:0] write_pointer=0,read_pointer=0;
+    reg [7:0] fault=0;
+    reg [9:0] raw_count=0,send_count=0;
+    reg raw_bad=0;
+    reg write_toggle=0,read_toggle=0;
+    reg [9:0] write_sector=0,read_sector=0;
+    wire write_ack,read_ack;
+    wire [7:0] write_error,read_error;
+    reg write_ack0=0,write_ack1=0,read_ack0=0,read_ack1=0;
+    reg send_pending=0;
+    reg [8:0] send_index=0;
+    wire [10:0] occupied=write_pointer-read_pointer;
+    wire start_session=!session_active && producer_state==P_IDLE && consumer_state==C_IDLE &&
+                       write_ack1==write_toggle && read_ack1==read_toggle &&
+                       enable && source_ready && start_lba!=0 && total_sectors!=0;
+    wire live=session_active && enable && source_ready;
+    wire producer_start=live && fault==0 && producer_state==P_IDLE && source_ready &&
+                        refilling && occupied<HIGH_SECTORS && producer_remaining!=0;
+    wire raw_store=producer_state==P_FILL && raw_valid;
+    wire raw_finish=producer_state==P_FILL && raw_done;
+    wire raw_complete=(raw_count==10'd512 && !raw_valid) ||
+                      (raw_count==10'd511 && raw_valid && raw_byte_index==9'd511);
+    wire raw_failed=raw_finish && (raw_error!=0 || raw_bad || !raw_complete ||
+                       (raw_valid && (raw_count>=512 || raw_byte_index!=raw_count[8:0])));
+    wire publish_write=raw_finish && !raw_failed && live && fault==0;
+    wire write_finished=producer_state==P_COMMIT && write_ack1==write_toggle;
+    wire read_finished=consumer_state==C_LOAD && read_ack1==read_toggle;
+    wire at_eof=consumer_remaining==0;
+    wire accept_client=client_req && !client_busy;
+    wire request_read=accept_client && fault==0 && !at_eof;
+    wire write_committed=write_finished && write_error==0 && live && fault==0;
+    wire read_committed=read_finished && read_error==0 && live && fault==0;
+    wire a_read=consumer_state==C_SEND && send_count<512 && !raw_store && live && fault==0;
+    wire a_en=raw_store || a_read;
+    wire [9:0] a_addr=raw_store ? {1'b0,raw_byte_index} : {1'b1,send_count[8:0]};
+    wire [7:0] a_dout;
+    wire b_en,b_we;
+    wire [9:0] b_addr;
+    wire [7:0] b_din,b_dout;
+
+    assign raw_req=producer_state==P_REQUEST && live && fault==0;
+    // The initial prefill holds the requester, rather than pretending to have
+    // granted a sector. Errors and unexpected EOF always get a bounded reply.
+    assign client_busy=consumer_state!=C_IDLE || !live ||
+                       (fault==0 && !at_eof && (!prefill_ready || occupied==0));
+    assign client_valid=send_pending && live && fault==0;
+    assign client_byte=a_dout;
+    assign client_byte_index=send_index;
+    assign client_done=live && (consumer_state==C_DONE || consumer_state==C_ERROR);
+    assign client_error=consumer_state==C_ERROR ? (fault!=0 ? fault : 8'he4) : 8'd0;
+    assign prefetch_low=live && fault==0 && producer_remaining!=0 && occupied<LOW_SECTORS;
+    assign session_busy=session_active || producer_state!=P_IDLE || consumer_state!=C_IDLE ||
+                        write_ack1!=write_toggle || read_ack1!=read_toggle;
+
+    audio_prefetch_stage staging(
+        .a_clk(sd_clk),.a_en(a_en),.a_we(raw_store),.a_addr(a_addr),.a_din(raw_byte),.a_dout(a_dout),
+        .b_clk(mem_clk),.b_en(b_en),.b_we(b_we),.b_addr(b_addr),.b_din(b_din),.b_dout(b_dout));
+    audio_sdram_dma dma(
+        .mem_clk(mem_clk),.rst_n(mem_rst_n),
+        .write_request_toggle(write_toggle),.write_sector(write_sector),
+        .write_ack_toggle(write_ack),.write_error(write_error),
+        .read_request_toggle(read_toggle),.read_sector(read_sector),
+        .read_ack_toggle(read_ack),.read_error(read_error),
+        .stage_en(b_en),.stage_we(b_we),.stage_addr(b_addr),.stage_din(b_din),.stage_dout(b_dout),
+        .video_read_busy(video_read_busy),.video_write_busy(video_write_busy),
+        .controller_busy(controller_busy),.refresh_active(refresh_active),
+        .mem_read_valid(mem_read_valid),.mem_read_data(mem_read_data),
+        .access_lock(access_lock),.read_owner(read_owner),
+        .mem_wr_en(mem_wr_en),.mem_wr_addr(mem_wr_addr),.mem_wr_data(mem_wr_data),
+        .mem_wr_mask(mem_wr_mask),.mem_rd_en(mem_rd_en),.mem_rd_addr(mem_rd_addr));
+
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) write_ack0<=0; else write_ack0<=write_ack;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) write_ack1<=0; else write_ack1<=write_ack0;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) read_ack0<=0; else read_ack0<=read_ack;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) read_ack1<=0; else read_ack1<=read_ack0;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) session_active<=0;
+        else if(!enable || !source_ready) session_active<=0;
+        else if(start_session) session_active<=1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) producer_remaining<=0;
+        else if(start_session) producer_remaining<=total_sectors;
+        else if(write_committed) producer_remaining<=producer_remaining-1'b1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) consumer_remaining<=0;
+        else if(start_session) consumer_remaining<=total_sectors;
+        else if(consumer_state==C_DONE && live) consumer_remaining<=consumer_remaining-1'b1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) write_pointer<=0;
+        else if(start_session) write_pointer<=0;
+        else if(write_committed) write_pointer<=write_pointer+1'b1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) read_pointer<=0;
+        else if(start_session) read_pointer<=0;
+        else if(read_committed) read_pointer<=read_pointer+1'b1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) prefill_ready<=0;
+        else if(start_session || !live) prefill_ready<=0;
+        else if(occupied>=PREFILL_SECTORS || producer_remaining==0) prefill_ready<=1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) playback_ready<=0;
+        else if(start_session || !live) playback_ready<=0;
+        else if(consumer_state==C_DONE && fault==0) playback_ready<=1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) refilling<=0;
+        else if(start_session) refilling<=1;
+        else if(!live || fault!=0 || occupied>=HIGH_SECTORS || producer_remaining==0) refilling<=0;
+        else if(occupied<LOW_SECTORS) refilling<=1;
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
+        if(!sd_rst_n) fault<=0;
+        else if(start_session) fault<=0;
+        else if(live && fault==0) begin
+            if(raw_failed) fault<=raw_error!=0 ? raw_error : 8'he1;
+            else if(write_finished && write_error!=0) fault<=8'he2;
+            else if(read_finished && read_error!=0) fault<=8'he3;
+        end
+    end
+    always @(posedge sd_clk or negedge sd_rst_n) begin
