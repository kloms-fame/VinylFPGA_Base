+`timescale 1ns/1ps
+module tb_audio_prefetch_sdram;
+    reg sd_clk=0,mem_clk=0;
+    always #5 sd_clk=~sd_clk;
+    always #4 mem_clk=~mem_clk;
+    reg sd_rst_n=0,mem_rst_n=0,enable=0,source_ready=1;
+    reg [31:0] start_lba=100,total_sectors=6;
+    reg client_req=0;
+    wire client_busy,client_valid,client_done;
+    wire [7:0] client_byte,client_error;
+    wire [8:0] client_byte_index;
+    wire raw_req;
+    wire [31:0] raw_lba;
+    reg raw_active=0,raw_valid=0,raw_done=0,hold_source=0;
+    reg [7:0] raw_byte=0,raw_error=0;
+    reg [8:0] raw_index=0;
+    reg [31:0] issuing_lba=0;
+    integer raw_cursor=0,raw_tick=0,raw_issued=0;
+    reg short_source=0,error_source=0;
+    wire raw_busy=raw_active || hold_source;
+    wire ready,low,busy,lock,owner,mwe,mre;
+    wire [20:0] mwa,mra;
+    wire [31:0] mwd;
+    wire [3:0] mask;
+    reg [31:0] memory[0:524287];
+    reg [11:0] return_valid=0;
+    reg [31:0] return_data[0:11];
+    integer i,j;
+    integer expected_lba=100,expected_index=0,received_sectors=0,done_count=0;
+    integer initial_done=0;
+    reg checking=1,expect_error=0;
+    reg [7:0] expected_error=0;
+    audio_prefetch_sdram #(.PREFILL_SECTORS(3),.HIGH_SECTORS(4),.LOW_SECTORS(3)) dut(
+        .sd_clk(sd_clk),.sd_rst_n(sd_rst_n),.mem_clk(mem_clk),.mem_rst_n(mem_rst_n),
+        .source_ready(source_ready),.enable(enable),.start_lba(start_lba),.total_sectors(total_sectors),
+        .client_req(client_req),.client_busy(client_busy),.client_valid(client_valid),
+        .client_byte(client_byte),.client_byte_index(client_byte_index),.client_done(client_done),
+        .client_error(client_error),.raw_req(raw_req),.raw_lba(raw_lba),.raw_busy(raw_busy),
+        .raw_valid(raw_valid),.raw_byte(raw_byte),.raw_byte_index(raw_index),
+        .raw_done(raw_done),.raw_error(raw_error),.playback_ready(ready),.prefetch_low(low),
+        .session_busy(busy),.video_read_busy(1'b0),.video_write_busy(1'b0),
+        .controller_busy(1'b0),.refresh_active(1'b0),.mem_read_valid(return_valid[11]),
+        .mem_read_data(return_data[11]),.access_lock(lock),.read_owner(owner),
+        .mem_wr_en(mwe),.mem_wr_addr(mwa),.mem_wr_data(mwd),.mem_wr_mask(mask),
+        .mem_rd_en(mre),.mem_rd_addr(mra));
+
+    // Registered SD responses, with inter-byte gaps and a complete transaction
+    // that continues to completion even if the playback session is cancelled.
+    always @(posedge sd_clk) begin
+        raw_tick=raw_tick+1;
+        raw_valid<=0;
+        raw_done<=0;
+        if(!source_ready) begin
+            raw_active<=0;
+        end else if(raw_req && !raw_busy) begin
+            raw_active<=1;
+            issuing_lba<=raw_lba;
+            raw_cursor=0;
+            raw_issued=raw_issued+1;
+            raw_error<=0;
+        end else if(raw_active && raw_tick%3==0) begin
+            if(raw_cursor==(short_source ? 511 : 512)) begin
+                raw_done<=1;
+                raw_error<=error_source ? 8'h35 : 0;
+                raw_active<=0;
+            end else begin
+                raw_valid<=1;
+                raw_index<=raw_cursor;
+                raw_byte<=issuing_lba*7+raw_cursor*13;
+                raw_cursor=raw_cursor+1;
+            end
+        end
+    end
+    always @(posedge mem_clk) begin
+        return_valid<={return_valid[10:0],mre};
+        if(mre) return_data[0]<=memory[mra];
+        for(j=1;j<12;j=j+1) return_data[j]<=return_data[j-1];
+        if(mwe) begin
+            if(mask!==4'b1110) $fatal(1,"PCM write mask incorrect");
+            memory[mwa][7:0]<=mwd[7:0];
+        end
+    end
+    always @(posedge sd_clk) begin
+        if(checking && enable && sd_rst_n) begin
+            if(client_req && !client_busy) expected_index=0;
+            if(client_valid) begin
+                if(client_byte_index!==expected_index[8:0]) $fatal(1,"client byte index %0d expected %0d",client_byte_index,expected_index);
+                if(client_byte!==((expected_lba*7+expected_index*13)&255))
+                    $fatal(1,"client byte %0d LBA %0d got %0h",expected_index,expected_lba,client_byte);
+                if(expect_error) $fatal(1,"invalid sector became visible");
+                expected_index=expected_index+1;
+            end
+            if(client_done) begin
+                if(expect_error) begin
+                    if(client_error!==expected_error) $fatal(1,"wrong client error %0h",client_error);
+                    if(low) $fatal(1,"fault still reserves SD priority");
+                end else begin
+                    if(client_error!=0 || expected_index!=512) $fatal(1,"successful sector incomplete %0d error%0h",expected_index,client_error);
+                    expected_lba=expected_lba+1;
+                    received_sectors=received_sectors+1;
+                end
+                done_count=done_count+1;
+                initial_done=1;
+            end
+            if(ready && !initial_done) $fatal(1,"playback released before first client sector");
+            if(dut.occupied>4) $fatal(1,"ring exceeded high watermark");
+        end
+    end
+    task request_sector;
+        integer t,old_done;
+        begin
+            old_done=done_count;
+            @(negedge sd_clk); client_req=1;
+            t=0;
+            while(client_busy && t<50000) begin @(negedge sd_clk); t=t+1; end
+            if(client_busy) $fatal(1,"client request stuck");
+            @(negedge sd_clk); client_req=0;
+            t=0;
+            while(done_count==old_done && t<50000) begin @(negedge sd_clk); t=t+1; end
+            if(done_count==old_done) $fatal(1,"client completion stuck");
+            repeat(2) @(negedge sd_clk);
+        end
+    endtask
+    task new_session;
+        input integer base,count;
+        begin
+            @(negedge sd_clk); enable=0; client_req=0;
+            repeat(3) @(negedge sd_clk);
+            expected_lba=base; expected_index=0; initial_done=0;
+            start_lba=base; total_sectors=count; enable=1;
+        end
+    endtask
+    initial begin
+        for(i=0;i<524288;i=i+1) memory[i]=32'h12345600;
+        repeat(5) @(negedge sd_clk);
+        sd_rst_n=1; mem_rst_n=1; enable=1;
+        for(i=0;i<6;i=i+1) request_sector;
+        if(raw_issued!=6 || !ready) $fatal(1,"initial sequence/EOF counts incorrect");
+        expect_error=1; expected_error=8'he4;
+        request_sector;
+        expect_error=0;
+        $display("PASS prefill, first-client playback release, all bytes, EOF, concurrent producer/consumer stage arbitration");
+
+        // A short clip must not wait forever for PREFILL_SECTORS entries.
+        new_session(300,2);
+        request_sector; request_sector;
+        $display("PASS short-track prefill below threshold");
+
+        // Cancel while raw SD is still supplying bytes; restart immediately.
+        new_session(500,10);
+        wait(raw_active && raw_cursor>20);
+        new_session(700,2);
+        request_sector; request_sector;
+        $display("PASS cancellation drains raw transaction and rejects old-session bytes");
+
+        // Cancel after the producer mailbox has crossed into the memory domain.
+        new_session(900,10);
+        wait(mwe);
+        new_session(1100,2);
+        request_sector; request_sector;
+        $display("PASS cancellation drains write DMA without stale commit");
+
+        // Cancel consumer DMA after granting a sector, before byte delivery.
+        new_session(1300,10);
+        @(negedge sd_clk); client_req=1;
+        wait(mre);
+        new_session(1500,2);
+        request_sector; request_sector;
+        $display("PASS cancellation drains read DMA without stale delivery");
+
+        short_source=1; expect_error=1; expected_error=8'he1;
+        new_session(1700,2);
+        request_sector;
+        short_source=0;
+        error_source=1; expected_error=8'h35;
+        new_session(1900,2);
+        request_sector;
+        error_source=0; expect_error=0;
+        $display("PASS incomplete/error raw sectors rejected before publication with bounded error replies");
+
+        // Media reset destroys the physical transaction and therefore raw_done.
+        // It must release P_FILL rather than wait for that destroyed response.
+        new_session(2000,10);
+        wait(raw_active && raw_cursor>20);
+        @(negedge sd_clk); source_ready=0;
+        repeat(8) @(negedge sd_clk);
+        if(busy) $fatal(1,"media reset left a phantom raw transaction");
+        start_lba=2050; total_sectors=2; expected_lba=2050; initial_done=0;
+        source_ready=1;
+        request_sector; request_sector;
+        $display("PASS media reset aborts destroyed raw transaction and restarts cleanly");
+
+        // More than 1024 entries forces both ring pointers through physical
+        // sector zero while producer and consumer keep operating concurrently.
+        new_session(2100,1030);
+        for(i=0;i<1030;i=i+1) request_sector;
+        if(dut.producer_remaining!=0 || dut.consumer_remaining!=0 || dut.occupied!=0 ||
+           dut.write_pointer!=1030 || dut.read_pointer!=1030)
+            $fatal(1,"ring rollover counts incorrect");
+        for(i=0;i<524288;i=i+1)
+            if(memory[i][31:8]!==24'h123456) $fatal(1,"RGB plane modified");
+        $display("PASS 1030 sequential sectors through 1024-slot ring rollover; RGB plane preserved");
+        $display("PASS tb_audio_prefetch_sdram");
+        $finish;
+    end
+    initial begin #60000000; $fatal(1,"global timeout"); end
+endmodule
diff --git a/sim/audio_cache/tb_wav_startup_ready.v b/sim/audio_cache/tb_wav_startup_ready.v
new file mode 100644
--- /dev/null
+++ b/sim/audio_cache/tb_wav_startup_ready.v
@@ -0,0 +1,96 @@
+`timescale 1ns/1ps
+module tb_wav_startup_ready;
+    reg wr_clk=0,rd_clk=0;
+    always #5 wr_clk=~wr_clk;
+    always #20 rd_clk=~rd_clk;
+    reg rst_n=0,enable=0,hold_second=0;
+    reg [31:0] sectors=2,valid_samples=257,sample_base=10000;
+    reg [7:0] skip=255;
+    wire req,ready,consumed,ended,idle;
+    wire [31:0] lba,count;
+    wire signed [15:0] sample;
+    wire sample_valid,underrun;
+    reg raw_busy=0,raw_valid=0,raw_done=0;
+    reg [7:0] raw_byte=0;
+    reg [8:0] raw_index=0;
+    integer cursor=0,issued=0,sector_number=0,rd_cycles=0;
+    integer observed=0,expected=255,test_number=1,first_sector_done=0;
+    reg tick=0;
+    wav_stream_player dut (
+        .wr_clk(wr_clk),.wr_rst_n(rst_n),.play_enable(enable),
+        .start_lba(32'd100),.total_sectors(sectors),.valid_samples(valid_samples),.skip_samples(skip),
+        .sd_req(req),.sd_lba(lba),.sd_busy(raw_busy || (hold_second && issued>0)),
+        .sd_valid(raw_valid),.sd_byte(raw_byte),.sd_byte_index(raw_index),.sd_done(raw_done),.sd_error(8'd0),
+        .rd_clk(rd_clk),.rd_rst_n(rst_n),.sample_tick(tick),.sample_out(sample),.sample_valid(sample_valid),
+        .sample_ready(ready),.startup_ready(ready),.sample_counter(count),.stream_active(),.stream_end(ended),
+        .reader_idle(idle),.sample_consumed(consumed),.buffer_low(),.sample_base(sample_base),.underrun_pulse(underrun));
+    always @(negedge rd_clk) begin
+        rd_cycles=rd_cycles+1;
+        tick=(rd_cycles%8)==0;
+    end
+    always @(posedge wr_clk) begin
+        raw_valid<=0;raw_done<=0;
+        if (!enable) begin
+            raw_busy<=0;cursor=0;issued=0;
+        end else if(req && !raw_busy && !(hold_second && issued>0)) begin
+            raw_busy<=1;sector_number=issued;issued=issued+1;cursor=0;
+        end else if(raw_busy) begin
+            if(cursor==512) begin
+                raw_busy<=0;raw_done<=1;
+                if(issued==1) first_sector_done=1;
+            end else begin
+                raw_valid<=1;raw_index<=cursor;
+                raw_byte <= (cursor%2)==0 ? (sector_number*256+cursor/2)&255 : (sector_number*256+cursor/2)>>8;
+                cursor=cursor+1;
+            end
+        end
+    end
+    always @(posedge rd_clk) begin
+        if(rst_n && consumed) begin
+            #1;
+            if(sample!==expected[15:0]) $fatal(1,"test%0d sample%0d got%0d expected%0d",test_number,observed,sample,expected);
+            observed=observed+1;expected=expected+1;
+        end else #1;
+        if(rst_n && underrun) $fatal(1,"test%0d false startup/seek underrun",test_number);
+    end
+    task stop_session;
+        begin
+            @(negedge wr_clk);enable=0;
+            repeat(12) @(negedge rd_clk);
+            if(ready || !idle) $fatal(1,"startup latch did not clear on stop");
+            observed=0;first_sector_done=0;
+        end
+    endtask
+    task wait_end;
+        input integer n;
+        integer cycles;
+        begin
+            cycles=0;
+            while(!ended && cycles<20000) begin @(negedge rd_clk);cycles=cycles+1;end
+            if(!ended || observed!=n) $fatal(1,"test%0d EOF count %0d expected%0d",test_number,observed,n);
+        end
+    endtask
+    initial begin
+        repeat(5) @(negedge wr_clk);
+        rst_n=1;enable=1;hold_second=1;
+        wait(first_sector_done);
+        repeat(100) @(negedge rd_clk);
+        if(ready || observed!=0 || count!=sample_base)
+            $fatal(1,"seek255 opened startup gate with only one usable FIFO sample");
+        hold_second=0;
+        wait_end(257);
+        $display("PASS seek255 holds until enough PCM samples, no false underrun, ordered257 samples");
+        stop_session;
+        test_number=2;sectors=1;valid_samples=6;skip=250;expected=250;sample_base=20000;enable=1;
+        wait_end(6);
+        $display("PASS short EOF releases startup with6 samples below256 threshold");
+        stop_session;
+        test_number=3;sectors=1;valid_samples=256;skip=0;expected=0;sample_base=0;enable=1;
+        wait_end(256);
+        $display("PASS normal startup ordered256 samples; stop clears readiness");
+        stop_session;
+        $display("PASS tb_wav_startup_ready");
+        $finish;
+    end
+    initial begin #3000000;$fatal(1,"Global timeout");end
+endmodule
diff --git a/sim/audio_cache/vendor/README.md b/sim/audio_cache/vendor/README.md
new file mode 100644
--- /dev/null
+++ b/sim/audio_cache/vendor/README.md
@@ -0,0 +1,27 @@
+# Vendor model checks
+
+Run from PowerShell at the repository root:
+
+```powershell
+& ./sim/audio_cache/vendor/run_vendor_mask.ps1
+```
+
+The script uses ModelSim SE 10.6e (`D:/modeltech64_10.6e/win64`), not the older Altera OEM simulator found first on PATH. Override `-ModelSimRoot`, `-TdRoot`, or `-OutputDirectory` when needed. Compilation, generated libraries, the downloaded model, and transcripts go to `%TEMP%/vinyl_vendor_mask_isolation_20261016` by default. No synthesis sources are replaced or decrypted.
+
+The production `audio_sdram_arbiter.v` is connected to the unmodified, protected Anlogic `sdr_as_ram`, `sdr_wrrd`, and `sdr_init_ref` controller sources. The test uses an independent physical SDRAM bus model, rather than replacing the controller user interface with ideal RAM.
+
+The physical model is the Micron MT48LC2M32B2 Verilog bus functional model, version 2.1 dated 2002-06-06, with the same four-bank, 2048-row, 256-column, 32-bit geometry as EM638325. It is fetched from the [FreeCores SDR controller repository](https://raw.githubusercontent.com/freecores/sdr_ctrl/master/verif/model/mt48lc2m32b2.v), preserving the Micron copyright and model header. The exact downloaded bytes must have SHA256 `F4A9D4392AAB3E6765D201D86DCD1350B9D1F5D6ADD016BBC5C79DA1E1AC5060`; the script rejects a different hash. The model is not redistributed in this repository.
+
+Checks observed on 2026-10-16:
+
+- Actual protected controller propagates dynamic write masks to physical DQM. It also propagates them during reads, so DQM must return to zero before admitting reads.
+- Actual arbiter preserves the active write mask through queued physical write data, then clears it after 16 quiet memory clocks. The inactive client's mask is deliberately changed immediately after the application write burst.
+- Graphics writes with `0001` preserve all 32 preexisting PCM bytes; audio writes with `1110` preserve all 96 RGB bytes; graphics rewrites preserve the new PCM. Model storage is checked after every writer.
+- All 32 subsequent full-lane physical read words match the combined RGB/PCM content in the model's specified output window.
+- Actual production staging wrapper plus TD `EG_PHY_BRAM32K` model passes 512-byte reads and writes in both directions at 100/125 MHz. `DP16K`, width `16`, `NOREG`, active-high chip select, and output-clock-enable tied high match the behavioral one-cycle read contract. Disabled CS holds output and prevents writes. Include `work.glbl` as another simulation top.
+
+This test is **not EM638325 timing signoff**. With the unchanged Micron model defaults and an ideal 180-degree shifted SDRAM clock, 8/32 application-side return samples are Z at BL4 boundaries, although all physical read words and stored bytes are correct. The transcript explicitly reports this observation separately from the byte-isolation PASS. Timing of the real Etron device, FPGA input path, and PLL phase must be assessed with its proper model or hardware. No production clock/latency changes were made from this supplementary model result. The authoritative Etron device documentation is [EM638325 revision 3.2](https://etron.com/wp-content/uploads/2022/04/EM638325_Rev-3.2.pdf).
+
+The controller's power counter takes approximately 1.049 ms to initialize at 125 MHz. `Sdr_busy` alone does not cover every trailing write/read beat; the explicit quiet interval and returned-data activity are required for the mask and owner transition.
+
+Pass markers are `PASS encrypted controller:` in `vendor_mask.log` and `PASS actual EG_PHY_BRAM32K` in `vendor_stage.log`. The script requires both markers and a successful simulator command.
