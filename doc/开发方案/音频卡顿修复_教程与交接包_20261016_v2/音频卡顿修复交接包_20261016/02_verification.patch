diff --git a/tools/run_audio_cache_regression.py b/tools/run_audio_cache_regression.py
new file mode 100644
--- /dev/null
+++ b/tools/run_audio_cache_regression.py
@@ -0,0 +1,49 @@
+"""Run audio SDRAM cache and affected media regressions with Icarus Verilog."""
+from pathlib import Path
+import json
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "sim/audio_cache/regression"
+OUT.mkdir(parents=True, exist_ok=True)
+CASES = {
+    "tb_audio_sdram_dma": ["src/audio/audio_sdram_dma.v", "sim/audio_cache/tb_audio_sdram_dma.v"],
+    "tb_audio_sdram_arbiter": ["src/audio/audio_sdram_arbiter.v", "sim/audio_cache/tb_audio_sdram_arbiter.v"],
+    "tb_audio_prefetch_sdram": ["src/audio/audio_prefetch_stage.v", "src/audio/audio_sdram_dma.v",
+                                  "src/audio/audio_prefetch_sdram.v", "sim/audio_cache/tb_audio_prefetch_sdram.v"],
+    "tb_wav_startup_ready": ["src/audio/wav_stream_player.v", "sim/audio_cache/tb_wav_startup_ready.v"],
+    "tb_wav_stream_player": ["src/audio/wav_stream_player.v", "sim/tb_wav_stream_player.v"],
+    "tb_wav_underrun": ["src/audio/wav_stream_player.v", "sim/tb_wav_underrun.v"],
+    "tb_s7_session": ["src/audio/stream_session.v", "sim/tb_s7_session.v"],
+    "tb_background_sector_mux": ["src/video/background_sector_mux.v", "sim/tb_background_sector_mux.v"],
+    "tb_media_write_pipeline": ["src/video/media_write_pipeline.v", "sim/tb_media_write_pipeline.v"],
+    "tb_mv_linear_write": ["src/SD/frame_fifo_write.v", "sim/tb_mv_linear_write.v"],
+    "tb_mv_frame_scheduler": ["src/video/mv_frame_scheduler.v", "sim/tb_mv_frame_scheduler.v"],
+    "tb_frame_fifo_read_pace": ["src/SD/frame_fifo_read.v", "src/video/background_raster_address.v",
+                                 "sim/tb_frame_fifo_read_pace.v"],
+}
+
+results = []
+for name, files in CASES.items():
+    image, log = OUT / f"{name}.vvp", OUT / f"{name}.log"
+    compile_flags = ["-DVINYL_AUDIO_CACHE_SIM"] if name == "tb_audio_prefetch_sdram" else []
+    compile_result = subprocess.run(["iverilog", "-g2012", *compile_flags, "-s", name, "-o", str(image), *files],
+                                    cwd=ROOT, text=True, capture_output=True)
+    transcript = compile_result.stdout + compile_result.stderr
+    status = compile_result.returncode
+    if status == 0:
+        try:
+            run = subprocess.run(["vvp", str(image)], cwd=ROOT, text=True, capture_output=True, timeout=120)
+            transcript += run.stdout + run.stderr
+            status = run.returncode
+        except subprocess.TimeoutExpired as exc:
+            transcript += (exc.stdout or "") + (exc.stderr or "") + "\nTIMEOUT\n"
+            status = 124
+    log.write_text(transcript, encoding="utf-8")
+    passed = status == 0 and "PASS" in transcript and "FAIL" not in transcript
+    results.append({"test": name, "pass": passed, "exit": status})
+    print(f"{'PASS' if passed else 'FAIL'} {name} ({log.relative_to(ROOT)})", flush=True)
+
+(OUT / "results.json").write_text(json.dumps(results, indent=2), encoding="utf-8")
+sys.exit(0 if all(item["pass"] for item in results) else 1)
diff --git a/sim/audio_cache/tb_audio_sdram_dma.v b/sim/audio_cache/tb_audio_sdram_dma.v
new file mode 100644
--- /dev/null
+++ b/sim/audio_cache/tb_audio_sdram_dma.v
@@ -0,0 +1,164 @@
+`timescale 1ns/1ps
+module tb_audio_sdram_dma;
+    reg clk=0;
+    always #4 clk=~clk;
+    reg rst_n=0;
+    reg wt=0,rt=0;
+    reg [9:0] ws=0,rs=0;
+    wire wa,ra;
+    wire [7:0] we,re;
+    wire se,sw;
+    wire [9:0] sa;
+    wire [7:0] si;
+    reg [7:0] so=0;
+    reg vr=0,vw=0,cb=0,ref_active=0,old_valid=0,drop_returns=0;
+    wire lock,owner,mwe,mre;
+    wire [20:0] mwa,mra;
+    wire [31:0] mwd;
+    wire [3:0] mask;
+    reg [7:0] staging[0:1023];
+    reg [31:0] memory[0:524287];
+    reg [10:0] return_valid=0;
+    reg [31:0] return_data[0:10];
+    wire valid=old_valid || return_valid[10];
+    wire [31:0] rddata=old_valid ? 32'hdeadbeef : return_data[10];
+    integer i,j,cycle=0,write_words=0,read_words=0,stage_writes=0;
+    integer chunk_words=0,chunk_count=0,unlock_cycles=0;
+    reg prior_lock=0,prior_command=0,check_yields=1;
+    reg [20:0] prior_address=0;
+    audio_sdram_dma #(.BURST_WORDS(32),.DRAIN_CYCLES(16),
+        .YIELD_CYCLES(16),.WATCHDOG_BITS(8)) dut(
+        .mem_clk(clk),.rst_n(rst_n),.write_request_toggle(wt),.write_sector(ws),
+        .write_ack_toggle(wa),.write_error(we),.read_request_toggle(rt),.read_sector(rs),
+        .read_ack_toggle(ra),.read_error(re),.stage_en(se),.stage_we(sw),.stage_addr(sa),
+        .stage_din(si),.stage_dout(so),.video_read_busy(vr),.video_write_busy(vw),
+        .controller_busy(cb),.refresh_active(ref_active),.mem_read_valid(valid),
+        .mem_read_data(rddata),.access_lock(lock),.read_owner(owner),.mem_wr_en(mwe),
+        .mem_wr_addr(mwa),.mem_wr_data(mwd),.mem_wr_mask(mask),
+        .mem_rd_en(mre),.mem_rd_addr(mra));
+
+    always @(posedge clk) begin
+        cycle=cycle+1;
+        if(se) begin
+            if(sw) begin staging[sa]<=si; stage_writes=stage_writes+1; end
+            else so<=staging[sa];
+        end
+        if(!rst_n) return_valid<=0;
+        else begin
+            return_valid <= {return_valid[9:0],mre && !drop_returns};
+            if(mre) return_data[0]<=memory[mra];
+            for(j=1;j<11;j=j+1) return_data[j]<=return_data[j-1];
+        end
+        if(rst_n) begin
+            if(mwe) begin
+                if(mask!==4'b1110) $fatal(1,"write mask corrupts RGB");
+                if(!lock) $fatal(1,"write without lock");
+                if(mwa>=524288) $fatal(1,"ring address overflow");
+                memory[mwa][7:0]<=mwd[7:0];
+                write_words=write_words+1;
+            end
+            if(mre) begin
+                if(!lock || !owner) $fatal(1,"read without ownership");
+                if(mra>=524288) $fatal(1,"ring read address overflow");
+                read_words=read_words+1;
+            end
+            if((mwe || mre) && (vr || vw || old_valid || ref_active))
+                $fatal(1,"DMA overlapped old video/refresh");
+            if(old_valid && (owner || sw)) $fatal(1,"old video return stolen");
+            if(sw && (!owner || !valid || sa<512)) $fatal(1,"invalid staging write");
+            if(lock && !prior_lock) begin
+                if(check_yields && chunk_count%16!=0 && unlock_cycles<16) $fatal(1,"graphics yield too short");
+                chunk_words=0;
+            end
+            if(!lock) unlock_cycles=unlock_cycles+1;
+            else unlock_cycles=0;
+            if(mwe || mre) begin
+                chunk_words=chunk_words+1;
+                if(chunk_words>32) $fatal(1,"chunk exceeds bound");
+                if(prior_command && (mwe ? mwa : mra)!==prior_address+1)
+                    $fatal(1,"noncontiguous word address");
+                prior_address=mwe ? mwa : mra;
+            end
+            if(!lock && prior_lock && chunk_words!=0) chunk_count=chunk_count+1;
+            prior_command=mwe || mre;
+            prior_lock=lock;
+        end
+    end
+
+    task await_write;
+        integer limit;
+        begin
+            limit=0;
+            while(wa!==wt && limit<10000) begin @(negedge clk); limit=limit+1; end
+            if(wa!==wt) $fatal(1,"write acknowledgement missing");
+            if(lock || mwe) $fatal(1,"write acknowledged before release");
+            repeat(2) @(negedge clk);
+        end
+    endtask
+    task await_read;
+        integer limit;
+        begin
+            limit=0;
+            while(ra!==rt && limit<10000) begin @(negedge clk); limit=limit+1; end
+            if(ra!==rt) $fatal(1,"read acknowledgement missing");
+            if(lock || owner) $fatal(1,"read acknowledged before drain");
+            repeat(2) @(negedge clk);
+        end
+    endtask
+    initial begin
+        for(i=0;i<524288;i=i+1) memory[i]=32'h5522aa00;
+        for(i=0;i<1024;i=i+1) staging[i]=i*13+7;
+        repeat(4) @(negedge clk);
+        rst_n=1;
+        // Last sector: cover address 0x7ffff and all 512 staging words.
+        vr=1; ws=1023; wt=1;
+        repeat(12) @(negedge clk);
+        if(!lock || mwe) $fatal(1,"lock must reserve before old video drain");
+        vr=0; old_valid=1;
+        repeat(4) @(negedge clk);
+        old_valid=0;
+        await_write;
+        if(we!=0 || write_words!=512) $fatal(1,"sector write count/error");
+        for(i=0;i<512;i=i+1) begin
+            if(memory[1023*512+i][7:0]!==staging[i]) $fatal(1,"staging read pipeline misaligned %0d",i);
+            if(memory[1023*512+i][31:8]!==24'h5522aa) $fatal(1,"RGB modified");
+        end
+        rs=1023; rt=1;
+        await_read;
+        if(re!=0 || read_words!=512 || stage_writes!=512) $fatal(1,"sector read count/error");
+        for(i=0;i<512;i=i+1)
+            if(staging[512+i]!==staging[i]) $fatal(1,"read return offset %0d",i);
+        if(chunk_count!=32) $fatal(1,"expected 16 chunks per sector, got %0d",chunk_count);
+        $display("PASS complete sector read/write, RGB preservation, last-sector boundary, old video drain, 32-word chunks and yields");
+
+        // Both mailbox toggles arrive together: consumer read gets priority.
+        ws=0; rs=1023; wt=0; rt=0;
+        while(ra!==rt) begin
+            @(negedge clk);
+            if(mwe) $fatal(1,"producer preempted pending consumer");
+        end
+        await_write;
+        if(we || re) $fatal(1,"priority operation failed");
+        for(i=0;i<512;i=i+1)
+            if(memory[i][7:0]!==staging[i]) $fatal(1,"sector zero wrapping failed");
+        $display("PASS simultaneous mailbox consumer priority and sector-zero wrap");
+
+        // Controller never becomes quiet: bounded error and lock release.
+        check_yields=0; cb=1; wt=1;
+        await_write;
+        if(we==0) $fatal(1,"stuck controller did not report error");
+        cb=0;
+        // Lost SDRAM returns must never report a successful consumer sector.
+        drop_returns=1; rt=1;
+        await_read;
+        if(re==0) $fatal(1,"missing read returns did not report error");
+        drop_returns=0;
+        rt=0;
+        await_read;
+        if(re!=0) $fatal(1,"new valid request did not clear prior error");
+        $display("PASS watchdogs release lock, invalid reads error, next mailbox recovers");
+        $display("PASS tb_audio_sdram_dma");
+        $finish;
+    end
+    initial begin #1000000; $fatal(1,"global simulation timeout"); end
+endmodule
diff --git a/sim/audio_cache/tb_audio_sdram_arbiter.v b/sim/audio_cache/tb_audio_sdram_arbiter.v
new file mode 100644
--- /dev/null
+++ b/sim/audio_cache/tb_audio_sdram_arbiter.v
@@ -0,0 +1,117 @@
+`timescale 1ns/1ps
+// Unit-level routing and byte-mask lifetime contract. The actual encrypted
+// SDRAM controller requires the separate vendor-controller simulation gate.
+module tb_audio_sdram_arbiter;
+    reg clk=0;
+    always #4 clk=~clk;
+    reg rst_n=0,controller_busy=0,refresh_active=0,read_valid=0;
+    reg audio_lock=0,audio_owner=0,gw=0,gr=0,aw=0,ar=0;
+    reg [20:0] gwa=21'd7,gra=21'd9,awa=21'd7,ara=21'd11;
+    reg [31:0] gwd=32'h55667700,awd=32'h000000cc;
+    wire stall,tail,gvalid,mw,mr;
+    wire [20:0] mwa,mra;
+    wire [31:0] mwd;
+    wire [3:0] mask;
+    reg [31:0] word7=32'h112233a5;
+    integer checks=0,i;
+    audio_sdram_arbiter #(.WRITE_DRAIN_CYCLES(16)) dut (
+        .mem_clk(clk),.rst_n(rst_n),.controller_busy(controller_busy),
+        .refresh_active(refresh_active),.mem_read_valid(read_valid),
+        .audio_lock(audio_lock),.audio_read_owner(audio_owner),
+        .graphics_wr_en(gw),.graphics_rd_en(gr),.graphics_wr_addr(gwa),
+        .graphics_rd_addr(gra),.graphics_wr_data(gwd),
+        .audio_wr_en(aw),.audio_rd_en(ar),.audio_wr_addr(awa),
+        .audio_rd_addr(ara),.audio_wr_data(awd),.audio_wr_mask(4'b1110),
+        .graphics_stall(stall),.write_tail_busy(tail),.graphics_read_valid(gvalid),
+        .mem_wr_en(mw),.mem_rd_en(mr),.mem_wr_addr(mwa),.mem_rd_addr(mra),
+        .mem_wr_data(mwd),.mem_wr_mask(mask));
+    always @(posedge clk) begin
+        if (rst_n && mw && mwa==7) begin
+            if (!mask[0]) word7[7:0]<=mwd[7:0];
+            if (!mask[1]) word7[15:8]<=mwd[15:8];
+            if (!mask[2]) word7[23:16]<=mwd[23:16];
+            if (!mask[3]) word7[31:24]<=mwd[31:24];
+        end
+        if (rst_n && mr && mask!==4'b0000)
+            $fatal(1,"A read was issued while a write mask was still held");
+        if (rst_n && gvalid !== (read_valid && !audio_owner))
+            $fatal(1,"Read owner routing differs from contract");
+    end
+    task check;
+        input condition;
+        input [511:0] message;
+        begin
+            checks=checks+1;
+            if (condition!==1'b1) $fatal(1,"%0s",message);
+        end
+    endtask
+    task tick;
+        begin @(posedge clk); #1; end
+    endtask
+    task settle_write_tail;
+        begin
+            for(i=0;i<15;i=i+1) begin
+                tick;
+                check(tail,"Mask cleared before 16 fully quiet clocks");
+            end
+            tick;
+            check(!tail && mask==0,"Write tail did not clear at quiet boundary");
+        end
+    endtask
+    initial begin
+        repeat(3) tick;
+        @(negedge clk); rst_n=1;
+        tick;
+        check(mask==0 && !tail && !stall,"Reset state is not quiet");
+        // A lock acquired during an old graphics burst must not steal it.
+        @(negedge clk); gr=1; audio_lock=1; read_valid=1;
+        #1; check(mr && mra==gra && gvalid && stall,
+                  "Lock acquisition stole an existing graphics read");
+        tick;
+        @(negedge clk); gr=0; read_valid=0; gw=1;
+        #1; check(mw && mwa==gwa && mwd==gwd && mask==1,
+                  "Existing graphics write was not passed with byte zero protected");
+        tick;
+        check(word7==32'h556677a5,"Graphics write overwrote cached PCM byte");
+        @(negedge clk); gw=0; controller_busy=1;
+        repeat(20) begin tick; check(mask==1 && tail,"Busy write mask lost"); end
+        @(negedge clk); controller_busy=0; refresh_active=1;
+        repeat(3) begin tick; check(mask==1 && tail,"Refresh erased write tail"); end
+        @(negedge clk); refresh_active=0;
+        repeat(5) tick;
+        @(negedge clk); read_valid=1;
+        tick;
+        check(gvalid && mask==1,"Old graphics return was misclassified as audio");
+        @(negedge clk); read_valid=0;
+        settle_write_tail;
+        check(stall,"Clearing write tail also released audio lock");
+        // PCM writes touch byte zero only; mask remains through queued writes.
+        @(negedge clk); aw=1;
+        #1; check(mw && mwa==awa && mask==14 && mwd==awd,
+                  "Audio byte write mux/mask incorrect");
+        tick;
+        check(word7==32'h556677cc,"PCM write overwrote RGB bytes");
+        @(negedge clk); aw=0; controller_busy=1;
+        repeat(8) begin tick; check(mask==14 && tail,"PCM mask not held through busy"); end
+        @(negedge clk); controller_busy=0;
+        settle_write_tail;
+        @(negedge clk); ar=1; audio_owner=1;
+        #1; check(mr && mra==ara && mask==0,"Audio read address or DQM incorrect");
+        tick;
+        @(negedge clk); ar=0; read_valid=1;
+        tick;
+        check(!gvalid,"Audio read return reached graphics FIFO");
+        @(negedge clk); read_valid=0;
+        repeat(3) tick;
+        @(negedge clk); audio_owner=0; audio_lock=0;
+        #1; check(!stall,"Graphics did not regain access after audio yield");
+        @(negedge clk); gw=1; gwd=32'h77889900;
+        tick;
+        check(word7==32'h778899cc,"Later graphics write erased the prefetched byte");
+        @(negedge clk); gw=0;
+        settle_write_tail;
+        $display("PASS tb_audio_sdram_arbiter checks=%0d RGB/PCM isolation, old graphics drain, mask hold/clear, ownership, yield",checks);
+        $finish;
+    end
+    initial begin #20000; $fatal(1,"Timeout"); end
+endmodule
