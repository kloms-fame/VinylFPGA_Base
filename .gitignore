*~
.#*
.vscode/.DS_Store
.idea/
.vscode/

# Reproducible resource optimization simulation outputs
sim/resource_opt/
prj/resource_opt_20261005/seed*/

# Per-round source snapshots and generated cycle-equivalence benches.
prj/resource_opt_verified_20261005/
sim/resource_opt_verified/
sim/counter_r5_results/
sim/ws2812_context/
sim/visual_feedback/
sim/x1x2_repair/visual_flow_*/
sim/x1x2_repair/vu_charge_*/
sim/x1x2_repair/o8_final/
sim/x1x2_repair/ws_context_r5/

# S4 曲目索引仿真夹具：.hex 是 RTL 仿真台必需的输入（$readmemh），必须入库；
# .img 可由 `python tools/test_vinyl_packer.py` 现场重建，不入库避免重复体积。
!sim/s4_fixture/
!sim/s4_fixture/*.hex
sim/s4_fixture/*.img
sim/s4_fixture/*.json

# S6 reproducible media/test results. Index vectors are kept for RTL-only runs.
sim/s6_20261006/*.img
sim/s6_20261006/*.json
!sim/s6_20261006/index_v1.hex
!sim/s6_20261006/index_v2.hex

# Local isolated development worktrees
.worktrees/

# Local Codex scratch files and preserved copies from history cleanup
/.codex_tmp/

# Rebuildable 128 MiB SD-card images; keep generated artifacts out of Git history.
/doc/资源/sd卡/stage3b/card_STAGE3B.img
/doc/资源/sd卡/stage4/card_STAGE4.img
# Rebuildable release SD-card images stay local; distribute them outside Git.
/doc/资源/sd卡/release_*/VinylFPGA_SD_*.img
VinylFPGA_MediaStudio/

# Final source repository: local integrations and generated TD/ModelSim files.
/.mcp.json
/.agents/
/prj/.lock.f
/prj/out/
*.bid
**/transcript
**/realtime_transcript
**/modelsim.ini
/sim/**/results.json

